# Salin file ini menjadi .env.local dan isi dengan kredensial project Supabase Anda.
# Ambil dari: Supabase Dashboard > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# WAJIB untuk fitur "Kelola Pengguna" (Superadmin membuat akun baru &
# menentukan perannya) di app/api/pengguna/route.ts.
# Ambil dari: Supabase Dashboard > Project Settings > API > service_role key
#
# !! RAHASIAKAN !! Kunci ini bisa melakukan APA SAJA (bypass RLS),
# termasuk membuat/menghapus akun. JANGAN PERNAH ditulis dengan prefix
# NEXT_PUBLIC_ dan JANGAN PERNAH dipakai di kode client/browser --
# hanya boleh dibaca di server (route handler / server component).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
